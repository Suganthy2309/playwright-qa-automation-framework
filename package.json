{
  "name": "playwright-qa-automation-framework",
  "version": "1.0.0",
  "description": "End-to-end UI and API test automation framework built with Playwright (JavaScript), Page Object Model, custom fixtures and GitHub Actions CI.",
  "author": "Suganthy Shanmugavel",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "docker:build": "docker build -t pw-qa-framework .",
    "docker:test": "docker run --rm --ipc=host -v \"$(pwd)/playwright-report:/app/playwright-report\" pw-qa-framework"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "dotenv": "^16.4.5"
  }
}
